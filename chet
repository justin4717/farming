public class Database
{
	public function _construct()
	{
		$this->con = mysqli_connect("localhost","root","","");
	}
	
	public function query($sql)
	{
		$result = array();
		$res=mysqli_query($this->con, $sql);
		while($row = mysql_fetch_assoc($res)) {
			$result[] = $row;
		}

		return $result;
	}
}


